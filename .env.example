# Postgres (required)
DATABASE_URL=postgresql://ycode:ycode@localhost:5432/ycode
# Set DATABASE_SSL=false for local Docker Postgres
DATABASE_SSL=false

# Auth (required in production — openssl rand -hex 32)
BETTER_AUTH_SECRET=
# Optional public app URL for auth callbacks
BETTER_AUTH_URL=http://localhost:3002
# Optional: pin OSS to a default site tenant
DEFAULT_TENANT_ID=

# File storage: local (default) or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=/a/local

# S3 / MinIO (when STORAGE_DRIVER=s3)
# S3_BUCKET=ycode
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=ycode
# S3_SECRET_ACCESS_KEY=ycodeycode
# S3_FORCE_PATH_STYLE=true

# Realtime (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Templates API
NEXT_PUBLIC_TEMPLATE_API_URL=
TEMPLATE_API_URL=
TEMPLATE_UPLOAD_API_KEY=

# Secret key for signing page auth cookies (can be generated using `openssl rand -hex 32`)
PAGE_AUTH_SECRET=

# Google Fonts API Key (only to used to execute `npm run fonts:update`)
GOOGLE_FONTS_API_KEY=

# AI builder (BYOK). Set an API key for at least one provider to enable the
# in-app AI agent. Keys can also be added in Settings → Agent instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY works too.
GEMINI_API_KEY=
# Optional: override the default model (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=
# Optional: seconds one AI chat request may run before the platform kills it.
# Must match the AI chat route's maxDuration in vercel.json (300 by default —
# the Vercel hobby-plan maximum). Raise both together on paid Vercel plans.
AI_CHAT_MAX_DURATION=

# Debug only: set to `true` to skip auth on /ycode/preview routes. Never enable in production.
DISABLE_PREVIEW_AUTH=
